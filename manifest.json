{
  "manifest_version": 3,
  "name": "JevGuard",
  "version": "1.0.0",
  "description": "AI-powered ad detection using Jev to identify and remove advertisements from webpages.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JevGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
    },
      "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}